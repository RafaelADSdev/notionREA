{
  "name": "bloco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint . --error-on-warnings && eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:spike": "vitest run tests/spikes",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "local:env": "node scripts/local-env.mjs",
    "test:e2e": "playwright test",
    "test:rls": "supabase test db",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --check"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-unique-id": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "27.4.0",
    "pg": "8.23.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
