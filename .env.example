# Gerar valores locais sem imprimi-los: pnpm local:env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor e testes locais; nunca usar prefixo NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
APP_URL=http://127.0.0.1:3000
GOOGLE_AUTH_ENABLED=false
ENABLE_COLLABORATION_SPIKE=false
# Prévia sem formulário de login, somente app 3000 + Supabase 54321 em loopback.
LOCAL_PREVIEW_ENABLED=false
# Publicação sem banco a pedido do responsável: mostra preparação e bloqueia APIs.
BLOCO_SETUP_MODE=false
# Workspace individual persistido no IndexedDB; sem conta ou conexão de dados remota.
BLOCO_LOCAL_MODE=false
